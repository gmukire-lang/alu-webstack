global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn 2048
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    redirect scheme https code 301

frontend https_front
    bind *:443 ssl crt /etc/ssl/certs/www.gracemukire.tech.pem
    default_backend web_servers

backend web_servers
    balance roundrobin
    option httpchk GET /
    server web-01 18.132.10.131:80 check
    server web-02 13.43.219.124:80 check
